# Example only. Do not commit a real .env.staging file.
# Render staging runs Node in production mode while labeling the deployed app as staging.
NODE_ENV="production"
SHODHFUND_DEPLOYMENT_ENV="staging"

# Staging-only Neon URLs. Keep actual values in Render, never in Git.
DATABASE_URL=""
DIRECT_DATABASE_URL=""
JWT_SECRET=""

PORT=4000
CORS_ORIGIN="https://placeholder.invalid"

# Default staging behavior avoids consuming the production Gemini quota.
AI_PROVIDER_ORDER=""
AI_BUILTIN_GUIDANCE_ENABLED="true"
AI_RECORD_CONTEXT_ENABLED="false"
# Optional private staging bill storage. Backblaze B2 is the no-card S3-compatible default.
OBJECT_STORAGE_PROVIDER="backblaze-b2"
B2_ENDPOINT=""
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET=""
B2_REGION=""

# Cloudflare R2 remains optional when an R2 subscription is available.
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_REGION="auto"
