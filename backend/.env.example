# Required PostgreSQL connection. This matches the optional root compose.yaml service.
DATABASE_URL="postgresql://shodhfund:shodhfund-local-only@localhost:5432/shodhfund?schema=public"

# Required in production: use a unique random value with at least 32 characters.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
NODE_ENV="development"
# Optional public deployment label: development, test, staging, or production.
SHODHFUND_DEPLOYMENT_ENV="development"

PORT=4000
CORS_ORIGIN="http://localhost:3000"

# The demo seed rejects production/staging, PostgreSQL system databases, and
# non-local hosts. Do not enable the remote override for shared or real data.
# SHODHFUND_ALLOW_REMOTE_DEMO_SEED="false"

# Optional server-only Ask AI provider. Never expose this key through a browser
# variable, request URL, log, source file, or committed environment file.
AI_PROVIDER_ORDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
AI_TIMEOUT_MS="15000"
AI_MAX_RETRIES="2"
AI_BUILTIN_GUIDANCE_ENABLED="true"
# Keep external record context off until institutional privacy/legal review is complete.
AI_RECORD_CONTEXT_ENABLED="false"
AI_PROBE_CACHE_SECONDS="300"

# Optional bill-extraction model; uses GEMINI_API_KEY on the server.
GEMINI_OCR_MODEL="gemini-3.1-flash-lite"

# Optional private Cloudflare R2 / S3-compatible bill storage. Keep all values server-only.
# R2_ENDPOINT example: https://<account-id>.r2.cloudflarestorage.com
# Do not configure a public bucket URL. The backend streams authorized downloads.
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_REGION="auto"
