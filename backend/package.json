{
  "name": "shodhfund-backend",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check:syntax": "node --check src/server.js && node --check src/fixed-routes.js && node --check src/ocr.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "pdfkit": "^0.16.0",
    "prisma": "^7.9.1"
  },
  "devDependencies": {
    "tsx": "^4.16.0"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
